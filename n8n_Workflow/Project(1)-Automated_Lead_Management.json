      "parameters": {
        "jsCode": "\nreturn $input.all().map(item => {\n  const lead = item.json;\n  const budget = Number(lead.budget);\n\n  let score;\n  let priority;\n\n  if (budget >= 1000) {\n    score = 80;\n    priority = \"High\";\n  } else if (budget >= 500) {\n    score = 50;\n    priority = \"Medium\";\n  } else {\n    score = 20;\n    priority = \"Low\";\n  }\n\n  return {\n    json: {\n      ...lead,\n      score,\n      priority\n    }\n  };\n});\n"
      },
